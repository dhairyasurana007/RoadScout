# Copy to .env (git-ignored) and fill in. Never commit the real key.
# Not needed until task 26; everything before it runs on the fake provider.
META_API_KEY=your-meta-api-key-here

# Optional: override the SQLite file location (default: data/roadscout.sqlite)
# ROADSCOUT_DB=data/roadscout.sqlite

# Optional: where uploaded video and GPX files are stored (default: data/storage, git-ignored)
# ROADSCOUT_STORAGE_DIR=data/storage

# Model provider: fake (default, no key), fixture (replay saved responses) or live (needs META_API_KEY)
# ROADSCOUT_PROVIDER=fake
# Fake provider scenario: default | empty | short_track | false_positive
# ROADSCOUT_FAKE_SCENARIO=default
# Fixture provider directory with detect.json and verify.json (default: fixtures/providers/tiny)
# ROADSCOUT_FIXTURES_DIR=fixtures/providers/tiny
# Hard cap on live spend in USD (default 20) and the append-only cost log ("off" disables the file)
# ROADSCOUT_SPEND_CAP_USD=20
# ROADSCOUT_COST_LOG=data/cost_log.jsonl
# Estimated USD per live call, used for the spend cap (default 0; set after the task 26 spike measures cost)
# ROADSCOUT_COST_PER_DETECT_USD=0
# ROADSCOUT_COST_PER_VERIFY_USD=0

# Preprocessing defaults: sampled frames per second, chunk length in seconds, max output height in pixels
# ROADSCOUT_PREPROCESS_FPS=3
# ROADSCOUT_CHUNK_SECONDS=10
# ROADSCOUT_PREPROCESS_MAX_HEIGHT=720

# SAM 3.1 hazard class prompts (default: config/hazard_prompts.json)
# ROADSCOUT_HAZARD_PROMPTS=config/hazard_prompts.json
